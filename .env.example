# Street Goose 034 — variáveis de ambiente
# Copie para .env.local e preencha. Nenhum valor aqui é real — sem isso
# preenchido, o app roda normalmente mas login, XP, ranking, recompensas e
# comunidade ficam em modo "não configurado" (UI completa, ações bloqueadas
# com aviso claro, nada é simulado como sucesso).

# ---- Supabase (obrigatório para toda a camada de conta/comércio/comunidade) ----
# Painel do projeto Supabase -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NUNCA colocar a service_role key aqui nem em qualquer variável VITE_* —
# ela só pode existir no servidor/Edge Functions, nunca no bundle do navegador.

# ---- OAuth Google (Supabase Auth -> Providers -> Google) ----
# Client ID/Secret vêm do Google Cloud Console (OAuth consent screen +
# credenciais OAuth 2.0). O Secret vai só no painel do Supabase, não aqui.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ---- OAuth Apple (Supabase Auth -> Providers -> Apple) ----
# Vem do Apple Developer (Sign in with Apple: Services ID, Team ID, Key ID,
# chave privada .p8). Configurado no painel do Supabase, não aqui.
VITE_APPLE_OAUTH_SERVICES_ID=

# ---- Pagamentos ----
# Nenhum PSP (processador de pagamento) está integrado ainda. Quando um for
# escolhido (Stripe, Mercado Pago, Pagar.me...) a chave PÚBLICA/publishable
# vai aqui; a chave secreta vai só em variável de servidor/Edge Function.
VITE_PAYMENT_PROVIDER=
VITE_PAYMENT_PUBLIC_KEY=

# ---- WhatsApp (já funcional hoje, não depende de nada acima — ver js/config.js) ----
# Preencher window.SG_CONTACT_CONFIG.whatsappNumber em js/config.js, formato
# E.164 sem "+" (ex: 5534999999999). Deixado fora deste .env porque é lido
# em runtime por um script legado, não em build-time pelo Vite.
